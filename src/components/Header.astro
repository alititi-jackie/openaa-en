---
import { NAV, SITE } from '../config/site';

interface Props {
  current?: string;
}
const { current = '/' } = Astro.props;
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={SITE.name}>
      <img src="/logo.png" alt="OpenAA" width="34" height="34" />
      <span class="brand-word">
        <b><em>Open</em>AA</b>
        <i class="brand-dot" aria-hidden="true"></i>
        <small>英语频道</small>
      </span>
    </a>
    <div class="header-actions" aria-label="页面操作">
      <a
        class="icon-btn go-button"
        href="https://go.openaa.com/"
        aria-label="打开 OpenAA Go 导航"
        title="OpenAA Go 导航"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
        </svg>
      </a>
      <button class="icon-btn" type="button" data-share aria-label="分享当前页面" title="分享当前页面">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="m8.7 10.7 6.6-4.4"></path>
          <path d="m8.7 13.3 6.6 4.4"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
<nav class="sub-nav" aria-label="频道导航">
  <div class="sub-nav-inner">
    {NAV.map((item) => (
      <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href="/search/" aria-current={current === '/search/' ? 'page' : undefined}>搜索</a>
  </div>
</nav>

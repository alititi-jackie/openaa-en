---
import { NAV, SITE } from '../config/site';

interface Props {
  current?: string;
}
const { current = '/' } = Astro.props;
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={SITE.name}>
      <img src="/logo.png" alt="" width="36" height="36" />
      <span class="brand-word"><b><em>Open</em>AA</b><small>英语频道</small></span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href="/" aria-current={current === '/' ? 'page' : undefined}>首页</a>
      <a href="https://openaa.com" target="_blank" rel="noopener">OpenAA</a>
    </nav>
    <div class="header-actions" aria-label="页面操作">
      <button class="icon-btn" type="button" data-install aria-label="下载到桌面" title="下载到桌面">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>
      </button>
      <button class="icon-btn" type="button" data-share aria-label="分享" title="分享">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"></path></svg>
      </button>
    </div>
  </div>
</header>
<nav class="sub-nav" aria-label="频道导航">
  <div class="sub-nav-inner">
    {NAV.map((item) => (
      <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href="/search/" aria-current={current === '/search/' ? 'page' : undefined}>搜索</a>
  </div>
</nav>

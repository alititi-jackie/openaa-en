---
/**
 * 句子行：英文 + 中文 + 操作按钮（朗读 / 复制 / 收藏）
 */
interface Props {
  en: string;
  zh: string;
  favId?: string;
  favKind?: 'word' | 'phrase' | 'scene';
}

const { en, zh, favId, favKind = 'phrase' } = Astro.props;
---
<div class="say-row">
  <div class="en">{en}</div>
  <div class="zh">{zh}</div>
  <div class="ops">
    <button type="button" class="btn small" data-speak={en} aria-label={`朗读：${en}`}>
      🔊 朗读
    </button>
    <button type="button" class="btn small" data-speak-slow={en} aria-label={`慢速朗读：${en}`}>
      🐢 慢速
    </button>
    <button type="button" class="btn small" data-copy={en} aria-label="复制英文">
      📋 复制
    </button>
    {favId && (
      <button
        type="button"
        class="btn small"
        data-fav={favId}
        data-kind={favKind}
        aria-pressed="false"
        aria-label="收藏"
      >
        ⭐ 收藏
      </button>
    )}
  </div>
</div>

---
import { ECO_LINKS, SITE } from '../config/site';
---
<footer class="site-footer">
  <div class="footer-inner">
    <nav class="footer-links" aria-label="页脚导航">
      <a href="/about/">关于本站</a>
      <a href="/help/">使用说明</a>
      <a href="/privacy/">隐私政策</a>
      <a href="/contact/">联系与反馈</a>
    </nav>
    <nav class="footer-links" aria-label="OpenAA 生态">
      {ECO_LINKS.map((l) => (
        <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
      ))}
    </nav>
    <button type="button" class="footer-install" data-install aria-label="添加到桌面">添加到桌面</button>
    <p>Copyright © OpenAA · 本站内容免费学习，英语表达以美国实际使用为准</p>
  </div>
</footer>

<style>
  .footer-install {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: 2px 0 14px;
    padding: 8px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    background: #fff;
    color: #4b5563;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .footer-install:hover {
    border-color: #bfdbfe;
    color: #1d4ed8;
  }
  .footer-install:focus-visible {
    outline: 2px solid #93c5fd;
    outline-offset: 2px;
  }
</style>

---
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  current?: string;
  wide?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, canonicalPath, current, wide, noindex, jsonLd, ogImage } = Astro.props;
const canonical = `https://en.openaa.com${canonicalPath}`;
const ogImageUrl = ogImage ?? 'https://en.openaa.com/logo.png';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#2563eb" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      jsonLd={jsonLd}
      ogImage={ogImageUrl}
    />
  </head>
  <body>
    <Header current={current} />
    <main>
      <div class={wide ? 'wrap' : 'wrap-article'}>
        <slot />
      </div>
    </main>
    <Footer />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script src="/js/ui.js" defer></script>
  </body>
</html>

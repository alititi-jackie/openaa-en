---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../data/categories';
---
<BaseLayout
  title="搜索 - OpenAA 美国生活英语"
  description="搜索美国生活英语：输入中文或英文，查找单词、常用句子和情景对话。"
  canonicalPath="/search/"
  noindex
  wide
>
  <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '搜索' }]} />
  <h1>搜索英语表达</h1>
  <div class="search-big" style="margin:0;max-width:100%">
    <label class="sr-only" for="search-input">搜索</label>
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      placeholder="输入中文或英文，例如：请假、pay stub……"
    />
  </div>
  <div class="pill-row" aria-label="分类筛选">
    {CATEGORIES.map((c) => (
      <a class="pill" href="#" data-cat-filter={c.id}>{c.icon} {c.nameCn}</a>
    ))}
  </div>
  <p id="search-count" role="status" style="color:var(--text-3)"></p>
  <div id="search-results-full"></div>
  <div id="search-empty" class="empty" hidden>
    <p>输入关键词开始搜索，或浏览分类：</p>
    <div class="pill-row" style="justify-content:center">
      {CATEGORIES.map((c) => (
        <a class="pill" href={`/categories/${c.id}/`}>{c.icon} {c.nameCn}</a>
      ))}
    </div>
  </div>
</BaseLayout>

<script src="/js/search.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.enSearch) window.enSearch.renderSearchPage();
  });
</script>

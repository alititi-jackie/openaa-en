  noindex
>
  <div class="empty">
    <h1>页面不存在（404）</h1>
    <p>您访问的页面可能已被移动或删除。</p>
    <p style="margin-top:20px">
      <a class="btn primary" href="/">回首页</a>
      <a class="btn" href="/search/" style="margin-left:8px">去搜索</a>
    </p>
  </div>
</BaseLayout>
